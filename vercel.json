{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "corepack pnpm install && corepack pnpm run build",
  "outputDirectory": "dist/public",
  "rewrites": [
    {
      "source": "/api/((?!trpc).*)",
      "destination": "/api/trpc"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}